<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ClassicFace" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="ClassicLight" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="ClassicHilight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClassicShadow" Color="#808080"/>
    <SolidColorBrush x:Key="ClassicDkShadow" Color="#404040"/>
    <SolidColorBrush x:Key="ClassicWindow" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClassicHighlight" Color="#000080"/>
    <SolidColorBrush x:Key="ClassicHighlightText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClassicGrayText" Color="#808080"/>

    <Style x:Key="ClassicFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3"
                               SnapsToDevicePixels="True"
                               Stroke="Black"
                               StrokeThickness="1"
                               StrokeDashArray="1 1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource ClassicFace}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="DefaultEdge" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <Border x:Name="EdgeDark" BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="0,0,1,1">
                            <Border x:Name="EdgeShadow" BorderBrush="{StaticResource ClassicShadow}" BorderThickness="0,0,1,1">
                                <Border x:Name="EdgeHilight" BorderBrush="{StaticResource ClassicHilight}" BorderThickness="1,1,0,0">
                                    <Border x:Name="EdgeLight" Background="{StaticResource ClassicFace}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="1,1,0,0">
                                        <Border x:Name="PressShift" Background="Transparent">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              RecognizesAccessKey="True"/>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="DefaultEdge" Property="BorderBrush" Value="Black"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="EdgeDark" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeShadow" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeHilight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="EdgeLight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource ClassicWindow}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ClassicHighlight}"/>
        <Setter Property="SelectionTextBrush" Value="{StaticResource ClassicHighlightText}"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border BorderBrush="{StaticResource ClassicShadow}" BorderThickness="1,1,0,0" SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource ClassicHilight}" BorderThickness="0,0,1,1">
                                <Border x:Name="Well" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Background" Value="{StaticResource ClassicFace}"/>
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicRaisedChrome" TargetType="ToggleButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="EdgeDark" BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                        <Border x:Name="EdgeShadow" BorderBrush="{StaticResource ClassicShadow}" BorderThickness="0,0,1,1">
                            <Border x:Name="EdgeHilight" BorderBrush="{StaticResource ClassicHilight}" BorderThickness="1,1,0,0">
                                <Border x:Name="EdgeLight" Background="{StaticResource ClassicFace}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="1,1,0,0">
                                    <Border x:Name="PressShift" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="EdgeDark" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeShadow" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeHilight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="EdgeLight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="EdgeDark" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeShadow" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeHilight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="EdgeLight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ClassicHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource ClassicHighlightText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="{StaticResource ClassicFace}"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Padding" Value="3,1,2,1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource ClassicShadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="1,1,0,0">
                                <Border BorderBrush="{StaticResource ClassicHilight}" BorderThickness="0,0,1,1">
                                    <Border Background="{StaticResource ClassicLight}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="0,0,1,1">
                                        <Grid>
                                            <Border x:Name="Selection" Background="{StaticResource ClassicFace}" Margin="0,0,17,0">
                                                <ContentPresenter x:Name="SelectionText"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                  IsHitTestVisible="False"/>
                                            </Border>
                                            <ToggleButton Width="16"
                                                          Margin="1"
                                                          HorizontalAlignment="Right"
                                                          ClickMode="Press"
                                                          Focusable="False"
                                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          Style="{StaticResource ClassicRaisedChrome}">
                                                <Path x:Name="Arrow"
                                                      Width="7"
                                                      Height="4"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L3.5,4 L7,0 Z"
                                                      Fill="Black"
                                                      Stretch="Fill"/>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="False"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource ClassicWindow}"
                                    BorderBrush="{StaticResource ClassicDkShadow}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Selection" Property="Background" Value="{StaticResource ClassicHighlight}"/>
                            <Setter TargetName="SelectionText" Property="TextElement.Foreground" Value="{StaticResource ClassicHighlightText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocusVisual}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="13" Height="13" VerticalAlignment="Center" BorderBrush="{StaticResource ClassicShadow}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="1,1,0,0">
                                <Border BorderBrush="{StaticResource ClassicHilight}" BorderThickness="0,0,1,1">
                                    <Border Background="{StaticResource ClassicWindow}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="0,0,1,1">
                                        <Path x:Name="Check"
                                              Width="9"
                                              Height="8"
                                              Margin="0,1,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M1,4 L3.2,7 L8,1"
                                              Stretch="Fill"
                                              Stroke="Black"
                                              StrokeEndLineCap="Square"
                                              StrokeStartLineCap="Square"
                                              StrokeThickness="1.4"
                                              Visibility="Collapsed"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                            <Setter TargetName="Check" Property="Stroke" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocusVisual}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource ClassicShadow}"/>
                            <Ellipse Margin="1,1,0,0" Fill="{StaticResource ClassicHilight}"/>
                            <Ellipse Margin="1" Fill="{StaticResource ClassicWindow}" Stroke="{StaticResource ClassicDkShadow}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="Black" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ClassicGrayText}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ClassicGrayText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="8,6,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,7,1,1" BorderBrush="{StaticResource ClassicShadow}" BorderThickness="1"/>
                        <Border Margin="1,8,0,0" BorderBrush="{StaticResource ClassicHilight}" BorderThickness="1"/>
                        <Border Margin="1,14,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="3,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource ClassicFace}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="EdgeDark" BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                        <Border x:Name="EdgeShadow" BorderBrush="{StaticResource ClassicShadow}" BorderThickness="0,0,1,1">
                            <Border x:Name="EdgeHilight" BorderBrush="{StaticResource ClassicHilight}" BorderThickness="1,1,0,0">
                                <Border x:Name="EdgeLight" Background="{StaticResource ClassicFace}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="1,1,0,0">
                                    <Border x:Name="PressShift" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="EdgeDark" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeShadow" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="EdgeHilight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="EdgeLight" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource ClassicFace}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="0" BorderBrush="{StaticResource ClassicDkShadow}" BorderThickness="0,0,1,1" SnapsToDevicePixels="True">
                        <Border BorderBrush="{StaticResource ClassicShadow}" BorderThickness="0,0,1,1">
                            <Border BorderBrush="{StaticResource ClassicHilight}" BorderThickness="1,1,0,0">
                                <Border Background="{StaticResource ClassicFace}" BorderBrush="{StaticResource ClassicLight}" BorderThickness="1,1,0,0"/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="Background" Value="{StaticResource ClassicFace}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>
                        <RepeatButton Command="ScrollBar.LineUpCommand" Style="{StaticResource ClassicScrollArrow}">
                            <Path Width="7" Height="4" Data="M0,4 L3.5,0 L7,4 Z" Fill="Black" Stretch="Fill"/>
                        </RepeatButton>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ClassicScrollPage}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ClassicScrollPage}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ClassicScrollThumb}" MinHeight="16"/>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource ClassicScrollArrow}">
                            <Path Width="7" Height="4" Data="M0,0 L3.5,4 L7,0 Z" Fill="Black" Stretch="Fill"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="MinHeight" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <RepeatButton Command="ScrollBar.LineLeftCommand" Style="{StaticResource ClassicScrollArrow}">
                                    <Path Width="4" Height="7" Data="M4,0 L0,3.5 L4,7 Z" Fill="Black" Stretch="Fill"/>
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ClassicScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ClassicScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ClassicScrollThumb}" MinWidth="16"/>
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource ClassicScrollArrow}">
                                    <Path Width="4" Height="7" Data="M0,0 L4,3.5 L0,7 Z" Fill="Black" Stretch="Fill"/>
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{TemplateBinding VerticalOffset}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{TemplateBinding HorizontalOffset}"/>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ClassicFace}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="AeroButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7F7F7" Offset="0"/>
        <GradientStop Color="#EBEBEB" Offset="0.49"/>
        <GradientStop Color="#DEDEDE" Offset="0.51"/>
        <GradientStop Color="#CFCFCF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF6FD" Offset="0"/>
        <GradientStop Color="#D8F0FC" Offset="0.49"/>
        <GradientStop Color="#BDE6FD" Offset="0.51"/>
        <GradientStop Color="#A6D9F4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroButtonPress" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A3D0EA" Offset="0"/>
        <GradientStop Color="#C5E5F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AeroItemHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF6FD" Offset="0"/>
        <GradientStop Color="#C4E5F6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AeroBlue" Color="#3C7FB1"/>
    <SolidColorBrush x:Key="AeroBlueGlow" Color="#7EB4EA"/>
    <SolidColorBrush x:Key="AeroTextBorder" Color="#ABADB3"/>
    <SolidColorBrush x:Key="AeroTextHover" Color="#6CA6D8"/>
    <SolidColorBrush x:Key="AeroDialog" Color="#F0F0F0"/>

    <Style TargetType="Button">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="Padding" Value="10,1"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="DefaultGlow" Margin="-1" BorderBrush="{StaticResource AeroBlueGlow}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="HoverGlow" Margin="-1" BorderBrush="{StaticResource AeroBlueGlow}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="GrayEdge" BorderBrush="#707070" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False"/>
                        <Border x:Name="DefaultEdge" BorderBrush="{StaticResource AeroBlue}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="HoverEdge" BorderBrush="{StaticResource AeroBlue}" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="PressEdge" BorderBrush="#2C628B" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="DisabledEdge" BorderBrush="#C9C9C9" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False" Opacity="0"/>
                        <Grid Margin="1">
                            <Border x:Name="Face" Background="{StaticResource AeroButtonFace}" CornerRadius="2"/>
                            <Border x:Name="HoverFace" Background="{StaticResource AeroButtonHover}" CornerRadius="2" Opacity="0"/>
                            <Border x:Name="PressFace" Background="{StaticResource AeroButtonPress}" CornerRadius="2" Opacity="0"/>
                            <Border x:Name="DisabledFace" Background="#F3F3F3" CornerRadius="2" Opacity="0"/>
                            <Border x:Name="Shine" Height="1" Margin="1,1,1,0" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E6FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter x:Name="Content"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="DefaultEdge" Property="Opacity" Value="1"/>
                            <Setter TargetName="DefaultGlow" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressFace" Property="Opacity" Value="1"/>
                            <Setter TargetName="PressEdge" Property="Opacity" Value="1"/>
                            <Setter TargetName="Shine" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0"/>
                            <Setter TargetName="HoverFace" Property="Opacity" Value="0"/>
                            <Setter TargetName="PressFace" Property="Opacity" Value="0"/>
                            <Setter TargetName="DisabledFace" Property="Opacity" Value="1"/>
                            <Setter TargetName="DisabledEdge" Property="Opacity" Value="1"/>
                            <Setter TargetName="DefaultEdge" Property="Opacity" Value="0"/>
                            <Setter TargetName="DefaultGlow" Property="Opacity" Value="0"/>
                            <Setter TargetName="HoverEdge" Property="Opacity" Value="0"/>
                            <Setter TargetName="HoverGlow" Property="Opacity" Value="0"/>
                            <Setter TargetName="Shine" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
        <Setter Property="SelectionBrush" Value="#C4E5F6"/>
        <Setter Property="SelectionTextBrush" Value="Black"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HoverGlow" Margin="-1" BorderBrush="#B5D6F5" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="FocusGlow" Margin="-1" BorderBrush="{StaticResource AeroBlueGlow}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="Base" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AeroTextBorder}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <Border x:Name="HoverLine" BorderBrush="{StaticResource AeroTextHover}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="FocusLine" BorderBrush="{StaticResource AeroBlue}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Base" Property="Background" Value="#F0F0F0"/>
                            <Setter TargetName="HoverLine" Property="Opacity" Value="0"/>
                            <Setter TargetName="HoverGlow" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusLine" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusGlow" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeroComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AeroItemHover}"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Padding" Value="4,1,22,1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HoverGlow" Margin="-1" BorderBrush="#B5D6F5" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="FocusGlow" Margin="-1" BorderBrush="{StaticResource AeroBlueGlow}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="Base" Background="{TemplateBinding Background}" BorderBrush="{StaticResource AeroTextBorder}" BorderThickness="1" IsHitTestVisible="False"/>
                        <Border x:Name="HoverLine" BorderBrush="{StaticResource AeroTextHover}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="FocusLine" BorderBrush="{StaticResource AeroBlue}" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border x:Name="OpenLine" BorderBrush="#2C628B" BorderThickness="1" IsHitTestVisible="False" Opacity="0"/>
                        <Border Width="17" Margin="1,1,1,1" HorizontalAlignment="Right" BorderBrush="#E4E4E4" BorderThickness="1,0,0,0" IsHitTestVisible="False">
                            <Grid>
                                <Border Background="{StaticResource AeroButtonFace}"/>
                                <Border x:Name="ArrowHover" Background="{StaticResource AeroButtonHover}" Opacity="0"/>
                                <Border x:Name="ArrowOpen" Background="{StaticResource AeroButtonPress}" Opacity="0"/>
                                <Path Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L3.5,4 L7,0 Z" Fill="#404040" Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <ToggleButton ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Style="{StaticResource AeroComboToggle}"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="False"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="White"
                                    BorderBrush="#6B9FC4"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="OpenLine" Property="Opacity" Value="1"/>
                            <Setter TargetName="ArrowOpen" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Base" Property="Background" Value="#F0F0F0"/>
                            <Setter TargetName="HoverLine" Property="Opacity" Value="0"/>
                            <Setter TargetName="HoverGlow" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusLine" Property="Opacity" Value="0"/>
                            <Setter TargetName="FocusGlow" Property="Opacity" Value="0"/>
                            <Setter TargetName="ArrowHover" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Border x:Name="Box" BorderBrush="#8D9096" BorderThickness="1" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E6E7EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="BoxOn" BorderBrush="#2C628B" BorderThickness="1" CornerRadius="2" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B7DFF6" Offset="0"/>
                                        <GradientStop Color="#5BAFE0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="BoxHover" BorderBrush="{StaticResource AeroBlue}" BorderThickness="1" CornerRadius="2" IsHitTestVisible="False" Opacity="0"/>
                            <Path x:Name="Check"
                                  Width="9"
                                  Height="7"
                                  Margin="0,1,0,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M1,3.2 L3.4,6 L8,1"
                                  Stretch="Fill"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.6"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                            <Setter TargetName="Check" Property="Stroke" Value="#C0C0C0"/>
                            <Setter TargetName="BoxOn" Property="Opacity" Value="0"/>
                            <Setter TargetName="BoxHover" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse x:Name="Plate" Fill="White" Stroke="#8D9096" StrokeThickness="1"/>
                            <Ellipse x:Name="PlateOn" Stroke="#2C628B" StrokeThickness="1" Opacity="0">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#D6EEF9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="PlateHover" Fill="Transparent" Stroke="{StaticResource AeroBlue}" StrokeThickness="1" Opacity="0"/>
                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="#1F6EA5" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlateHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlateHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PlateOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A0A0A0"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#B0B0B0"/>
                            <Setter TargetName="PlateHover" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="8,6,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,8,0,0" BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="2"/>
                        <Border Margin="1,16,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="4,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource AeroDialog}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeroScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Face" Background="{StaticResource AeroDialog}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AeroButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AeroButtonPress}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeroScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource AeroDialog}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeroScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Thumb" Margin="2" Background="#CDCDCD" BorderBrush="#A6A6A6" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AeroButtonHover}"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="{StaticResource AeroBlue}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AeroButtonPress}"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="#2C628B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="17"/>
        <Setter Property="MinWidth" Value="17"/>
        <Setter Property="Background" Value="{StaticResource AeroDialog}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True" Background="{StaticResource AeroDialog}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="17"/>
                        </Grid.RowDefinitions>
                        <RepeatButton Command="ScrollBar.LineUpCommand" Style="{StaticResource AeroScrollArrow}">
                            <Path Width="7" Height="4" Data="M0,4 L3.5,0 L7,4 Z" Fill="#404040" Stretch="Fill"/>
                        </RepeatButton>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource AeroScrollPage}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource AeroScrollPage}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="18" Style="{StaticResource AeroScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource AeroScrollArrow}">
                            <Path Width="7" Height="4" Data="M0,0 L3.5,4 L7,0 Z" Fill="#404040" Stretch="Fill"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="17"/>
                <Setter Property="MinHeight" Value="17"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid SnapsToDevicePixels="True" Background="{StaticResource AeroDialog}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="17"/>
                                </Grid.ColumnDefinitions>
                                <RepeatButton Command="ScrollBar.LineLeftCommand" Style="{StaticResource AeroScrollArrow}">
                                    <Path Width="4" Height="7" Data="M4,0 L0,3.5 L4,7 Z" Fill="#404040" Stretch="Fill"/>
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource AeroScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource AeroScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinWidth="18" Style="{StaticResource AeroScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource AeroScrollArrow}">
                                    <Path Width="4" Height="7" Data="M0,0 L4,3.5 L0,7 Z" Fill="#404040" Stretch="Fill"/>
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{TemplateBinding VerticalOffset}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{TemplateBinding HorizontalOffset}"/>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource AeroDialog}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
